  "item": [
    {
      "name": "Estado da API (ping)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/ping",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "ping"
          ]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
