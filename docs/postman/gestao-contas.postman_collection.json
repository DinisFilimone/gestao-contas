      "item": [
        {
          "name": "Login (administrador)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set(\"adminToken\", pm.response.json().token);",
                  "pm.test(\"perfil ADMIN\", function () { pm.expect(pm.response.json().role).to.eql(\"ADMIN\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar conta A (cliente 1, saldo 1000)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "accounts"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Cliente A\",\n  \"nuit\": \"{{nuitA}}\",\n  \"accountNumber\": \"{{accountA}}\",\n  \"accountType\": \"ORDEM\",\n  \"initialBalance\": 1000.0,\n  \"username\": \"{{userA}}\",\n  \"password\": \"Cliente@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Date.now().toString().slice(-9);",
                  "pm.collectionVariables.set(\"accountA\", \"1\" + n);",
                  "pm.collectionVariables.set(\"nuitA\", n);",
                  "pm.collectionVariables.set(\"userA\", \"clientea\" + n.slice(-6));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", function () { pm.response.to.have.status(201); });"
                ]
              }
            }
          ]
        },
        {
