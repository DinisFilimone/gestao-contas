            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fromAccount\": \"1{{runId}}1\",\n  \"toAccount\": \"1{{runId}}2\",\n  \"amount\": 100.0,\n  \"description\": \"Renda de Outubro\"\n}"
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clienteToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 201', () => pm.response.to.have.status(201));",
                  "pm.test('Tem referencia e saldo resultante 900.00', () => {",
                  "  const j = pm.response.json();",
                  "  pm.expect(j.reference).to.be.a('string');",
                  "  pm.expect(Number(j.sourceBalanceAfter)).to.eql(900);",
                  "});"
                ]
              }
            }
          ]
        },
