{
  "info": {
    "name": "Gestão de Contas - API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Executar por ordem (Run collection). Requer a API a correr. Os 'esperado' devem passar com o estado indicado."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "clienteToken",
      "value": ""
